@model LicenseFormViewModel
@{
    ViewData["Title"] = "Add License";
}
<h1>Add license</h1>
<form asp-action="Create" method="post" class="card form-card">
    <input asp-for="ProviderId" type="hidden" />
    <partial name="_LicenseForm" model="Model" />
    <div class="form-actions"><a class="button secondary" asp-controller="Providers" asp-action="Details" asp-route-id="@Model.ProviderId">Cancel</a><button class="button" type="submit">Create license</button></div>
</form>
