<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Provider Management</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <div class="container nav-wrap">
        <a class="brand" asp-controller="Providers" asp-action="Index">Provider Management</a>
        <nav>
            <a asp-controller="Providers" asp-action="Index">Providers</a>
            <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        </nav>
    </div>
</header>
<main class="container page">
    @if (TempData["Success"] is string success)
    {
        <div class="alert success">@success</div>
    }
    @RenderBody()
</main>
<footer class="container footer">ASP.NET Core MVC · EF Core · SQLite · Soft-delete by design</footer>
</body>
</html>
