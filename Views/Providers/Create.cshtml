@model ProviderFormViewModel
@{
    ViewData["Title"] = "Add Provider";
}
<h1>Add provider</h1>
<form asp-action="Create" method="post" class="card form-card">
    <partial name="_ProviderForm" model="Model" />
    <div class="form-actions"><a class="button secondary" asp-action="Index">Cancel</a><button class="button" type="submit">Create provider</button></div>
</form>
